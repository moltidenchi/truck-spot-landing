{
  "$description": "Truck Spot design tokens (W3C Design Tokens draft format). tools/build_tokens.mjs turns this file into CSS custom properties.",
  "color": {
    "asphalt": {
      "$type": "color",
      "$value": "#1D2127",
      "$description": "Ink: text, dark surfaces, wordmark"
    },
    "asphalt-soft": {
      "$type": "color",
      "$value": "#343A44",
      "$description": "Hover state of dark buttons"
    },
    "ketchup": {
      "$type": "color",
      "$value": "#C8281B",
      "$description": "Brand red: logo pin, primary buttons, links on light"
    },
    "ketchup-dark": {
      "$type": "color",
      "$value": "#A11F14",
      "$description": "Hover/pressed state of ketchup"
    },
    "mustard": {
      "$type": "color",
      "$value": "#FFC23C",
      "$description": "Brand yellow: hero, awning stripes, highlights on dark"
    },
    "mustard-light": {
      "$type": "color",
      "$value": "#FFE3A3",
      "$description": "Soft highlight, selected filter on light"
    },
    "curb": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "Surface: page and ticket background"
    },
    "fog": {
      "$type": "color",
      "$value": "#F1F2F4",
      "$description": "Alternate section background"
    },
    "kerb": {
      "$type": "color",
      "$value": "#59616C",
      "$description": "Secondary text, input borders"
    },
    "smoke": {
      "$type": "color",
      "$value": "#C9CDD3",
      "$description": "Secondary text on asphalt"
    },
    "line": {
      "$type": "color",
      "$value": "#D5D8DD",
      "$description": "Decorative dividers only (not for component boundaries)"
    },
    "lettuce": {
      "$type": "color",
      "$value": "#1E7A46",
      "$description": "Status: open now"
    },
    "amber": {
      "$type": "color",
      "$value": "#8A4B00",
      "$description": "Status: closing soon (text)"
    },
    "you": {
      "$type": "color",
      "$value": "#1F5FBF",
      "$description": "Your-location dot on the map"
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Big Shoulders Display",
        "Arial Narrow",
        "sans-serif"
      ],
      "$description": "Headlines, truck names, wordmark (weights 700-900)"
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Atkinson Hyperlegible",
        "system-ui",
        "sans-serif"
      ],
      "$description": "Body, UI, forms (400, 700)"
    }
  },
  "size": {
    "text-xs": {
      "$type": "dimension",
      "$value": "0.8125rem"
    },
    "text-sm": {
      "$type": "dimension",
      "$value": "0.9375rem"
    },
    "text-md": {
      "$type": "dimension",
      "$value": "1.0625rem"
    },
    "text-lg": {
      "$type": "dimension",
      "$value": "1.375rem"
    },
    "text-xl": {
      "$type": "dimension",
      "$value": "2rem"
    },
    "text-2xl": {
      "$type": "dimension",
      "$value": "3rem"
    },
    "text-hero": {
      "$type": "dimension",
      "$value": "clamp(3rem, 2rem + 5vw, 6.5rem)"
    }
  },
  "space": {
    "1": {
      "$type": "dimension",
      "$value": "0.25rem"
    },
    "2": {
      "$type": "dimension",
      "$value": "0.5rem"
    },
    "3": {
      "$type": "dimension",
      "$value": "0.75rem"
    },
    "4": {
      "$type": "dimension",
      "$value": "1rem"
    },
    "6": {
      "$type": "dimension",
      "$value": "1.5rem"
    },
    "8": {
      "$type": "dimension",
      "$value": "2rem"
    },
    "12": {
      "$type": "dimension",
      "$value": "3rem"
    },
    "16": {
      "$type": "dimension",
      "$value": "4rem"
    },
    "24": {
      "$type": "dimension",
      "$value": "6rem"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "Inputs, chips"
    },
    "md": {
      "$type": "dimension",
      "$value": "10px",
      "$description": "Buttons, tickets"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px",
      "$description": "Store buttons, filter chips"
    }
  },
  "shadow": {
    "ticket": {
      "$type": "shadow",
      "$value": "0 1px 0 #D5D8DD, 0 6px 18px -10px rgba(29, 33, 39, 0.45)"
    }
  },
  "layout": {
    "max-width": {
      "$type": "dimension",
      "$value": "76rem"
    },
    "header-height": {
      "$type": "dimension",
      "$value": "4rem"
    }
  }
}
